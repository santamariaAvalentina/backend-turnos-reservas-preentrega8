
<h1>Servicios odontológicos disponibles</h1>

<div id="services-container">

  {{#each services}}
    <article>
      <h2> {{name}}</h2>
      <p>Este servicio consta de: {{description}}</p>
      <p>Duración: {{duration}} minutos</p>
      <p>Precio: ${{price}}</p>
      <p>Categoría: {{category}}</p>

      {{#if available}}
        <p>Servicio disponible</p>
      {{else}}
        <p>Servicio no disponible</p>
      {{/if}}
    </article>
  {{/each}}

</div>

